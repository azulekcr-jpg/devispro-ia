# Copiez ce fichier en .env.local (local) ou saisissez ces variables chez l'hébergeur.
# Ne commitez JAMAIS de vraies valeurs.

# URL publique du site (http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : ces deux valeurs sont publiques (URL du projet et clé "anon" / "publishable")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Envoi des devis par e-mail (Resend) ----
# SECRET, serveur uniquement : à saisir dans Vercel (Settings > Environment Variables), jamais sur GitHub.
RESEND_API_KEY=
# Adresse d'expédition d'un domaine VÉRIFIÉ chez Resend, par exemple : DevisPro <devis@votredomaine.fr>
EMAIL_FROM=
